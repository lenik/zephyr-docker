# Install: sudo cp docker/logrotate/zephyr /etc/logrotate.d/zephyr
# Runtime logs live under i-local/ (see ../i-local).

# App logs (under datadir; also reachable via i-local/log/{backend,web,mobile} symlinks)
/home/figma/zephyr/i-local/data/log/backend/*.log
/home/figma/zephyr/i-local/data/log/web/*.log
/home/figma/zephyr/i-local/data/log/mobile/*.log
/home/figma/zephyr/i-local/log/nginx/*.log
/home/figma/zephyr/i-local/log/postgresql/*.log
{
    weekly
    rotate 8
    size 50M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0664 root root
}
