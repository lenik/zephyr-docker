#!/bin/bash
    : ${RCSID:=$Id: - @VERSION@ 2026-08-13 16:00:00 - $}
    : ${PROGRAM_TITLE:="Make docker image from zephyr-docker template"}
    : ${PROGRAM_SYNTAX:="[OPTIONS] [--] REPO"
                        "(REPO is the path to the application repository)"}

    . shlib-import cliboot
    option -e --e2e            "Include e2e / Playwright module"
    option -m --mobile         "Include mobile www module"
    option -f --force-build    "Force web/backend rebuild in prepare-context"
    option -k --keep-temp      "Keep forked template temp dir on failure"
    option -q --quiet
    option -v --verbose
    option -h --help
    option    --version

    opt_e2e=0
    opt_mobile=0
    opt_force_build=0
    opt_keep_temp=0

function setopt() {
    case "$1" in
        -e|--e2e)
            opt_e2e=1;;
        -m|--mobile)
            opt_mobile=1;;
        -f|--force-build)
            opt_force_build=1;;
        -k|--keep-temp)
            opt_keep_temp=1;;
        -h|--help)
            help $1; exit;;
        -q|--quiet)
            LOGLEVEL=$((LOGLEVEL - 1));;
        -v|--verbose)
            LOGLEVEL=$((LOGLEVEL + 1));;
        --version)
            show_version; exit;;
        *)
            quit "invalid option: $1";;
    esac
}

function find_template_dir() {
    local dir
    if [ -n "${ZEPHYR_DOCKER_TEMPLATE:-}" ]; then
        dir=$ZEPHYR_DOCKER_TEMPLATE
        [ -d "$dir" ] || quit "ZEPHYR_DOCKER_TEMPLATE not a directory: $dir"
        printf '%s\n' "$dir"
        return 0
    fi
    # Dev tree: ./docker next to this script
    if [ -d "$__DIR__/docker" ]; then
        printf '%s\n' "$__DIR__/docker"
        return 0
    fi
    # Installed: $prefix/share/zephyr-docker/docker
    dir="@datadir@/zephyr-docker/docker"
    if [ -d "$dir" ]; then
        printf '%s\n' "$dir"
        return 0
    fi
    quit "zephyr-docker template not found (set ZEPHYR_DOCKER_TEMPLATE or install zephyr-docker)"
}

function main() {
    local repo="$1"
    if [ -z "$repo" ]; then
        repo="$PWD"
    fi
    if [ ! -d "$repo" ]; then
        quit "repo not found: $repo"
    fi
    repodir=$(realpath "$repo")

    if [ ! -d "$repodir/backend" ] || [ ! -d "$repodir/web" ] || [ ! -d "$repodir/prisma" ]; then
        quit "repo missing backend/, web/, or prisma/: $repodir"
    fi

    projectname=$(basename "$repodir")
    PROJECTNAME=$(echo "$projectname" | tr '[:lower:]' '[:upper:]')

    # Prefer live .env PORT, else .env.example. Template ports use x990/x991
    # (e.g. PG 5990, host web 8990); replaced with (PORT%1000) and +1.
    backend_port=3000
    for envfile in "$repodir/backend/.env" "$repodir/backend/.env.example"; do
        if [ -f "$envfile" ]; then
            if match=$(grep -P -o '^PORT=(\d+)$' "$envfile"); then
                backend_port=${match#PORT=}
                break
            fi
        fi
    done
    port0=$((backend_port % 1000))
    port1=$((port0 + 1))
    port0=000$port0
    port1=000$port1
    port0=${port0: -3}
    port1=${port1: -3}

    __FILE__=$(realpath "$0")
    __DIR__=${__FILE__%/*}
    templdir=$(find_template_dir)

    forkdir=$(mktemp -d -t "docker-${projectname}.XXXXXX")
    cleanup() {
        if [ "$opt_keep_temp" -eq 1 ]; then
            _log1 "keeping temp fork: $forkdir"
            return 0
        fi
        rm -rf "$forkdir"
    }
    trap cleanup EXIT

    _log1 "template: $templdir"
    _log1 "repo:     $repodir ($projectname)"
    _log1 "ports:    *${port0} / *${port1}  (from backend PORT=$backend_port)"

    # Materialize a project-specific fork (do not pollute the template tree).
    rsync -a \
        --exclude '.git/' \
        --exclude '.build-ctx/' \
        --exclude '.build-ctx.prev/' \
        --exclude 'vendor/' \
        "$templdir/" "$forkdir/"

    # Split literals so this script itself is not rewritten by repl.
    repl -ru zep""hyr "$projectname" "$forkdir"
    repl -ru ZEP""HYR "$PROJECTNAME" "$forkdir"
    repl -ru 9"9"0 "$port0" "$forkdir"
    repl -ru 9"9"1 "$port1" "$forkdir"

    # repl only rewrites file contents — rename paths that still contain the placeholder.
    while IFS= read -r -d '' path; do
        base=$(basename "$path")
        dir=$(dirname "$path")
        newbase=${base//zep''hyr/$projectname}
        newbase=${newbase//ZEP''HYR/$PROJECTNAME}
        if [ "$base" != "$newbase" ]; then
            _log1 "rename $(realpath --relative-to="$forkdir" "$path" 2>/dev/null || echo "$base") → $newbase"
            mv "$path" "$dir/$newbase"
        fi
    done < <(find "$forkdir" -depth \( -name '*zep''hyr*' -o -name '*ZEP''HYR*' \) -print0)

    repodockerdir="$repodir/docker"
    mkdir -p "$repodockerdir"
    _log1 "install → $repodockerdir"
    rsync -a --delete \
        --exclude '.build-ctx/' \
        --exclude '.build-ctx.prev/' \
        --exclude 'vendor/' \
        "$forkdir/" "$repodockerdir/"

    prepare_opts=()
    [ "$opt_e2e" -eq 1 ] && prepare_opts+=(-e)
    [ "$opt_mobile" -eq 1 ] && prepare_opts+=(-m)
    [ "$opt_force_build" -eq 1 ] && prepare_opts+=(-f)

    _log1 "make -C docker build PREPARE_OPTS='${prepare_opts[*]}'"
    make -C "$repodockerdir" build \
        REPO="$repodir" \
        PREPARE_OPTS="${prepare_opts[*]}"
}

boot "$@"
